# Application
APP_ENV=development
APP_DEBUG=true
APP_NAME=OneStore
APP_VERSION=2.0.0
APP_URL=http://localhost:8000
BASE_PATH=

# Database
DB_HOST=localhost
DB_NAME=onestore_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# File Upload (in bytes, default 5MB)
MAX_FILE_SIZE=5242880

# Session
SESSION_TIMEOUT=7200
SESSION_NAME=onestore_session
